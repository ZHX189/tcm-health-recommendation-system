{
  "name": "tcm-health-web",
  "version": "1.0.0",
  "private": true,
  "description": "中医养生平台前端 - 古朴典雅中式风格",
  "author": "Ti",
  "scripts": {
    "dev:user": "pnpm --filter user-web dev",
    "dev:staff": "pnpm --filter staff-web dev",
    "dev:admin": "pnpm --filter admin-web dev",
    "build:user": "pnpm --filter user-web build",
    "build:staff": "pnpm --filter staff-web build",
    "build:admin": "pnpm --filter admin-web build",
    "build:all": "pnpm -r build"
  },
  "dependencies": {
    "axios": "^1.6.5",
    "echarts": "^5.4.3",
    "element-plus": "^2.5.3",
    "pinia": "^2.1.7",
    "vue": "^3.4.15",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.3",
    "vite": "^5.0.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "vue-demi",
      "es5-ext"
    ]
  }
}
